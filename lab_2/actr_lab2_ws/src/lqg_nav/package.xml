<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lqg_nav</name>
  <version>0.1.0</version>
  <description>
    Lab 2 (Cognitive architectures): an LQG controller (LQR + Kalman filter) that drives the TurtleBot3 of Lab 1
    along the path of the Nav2 planner, instead of the standard Nav2 controller. The ACT-R agent of Lab 1
    (package actr_lab1) is used without changes; it only calls another action.
  </description>
  <maintainer email="pfuentessantander@gmail.com">Pedro</maintainer>
  <license>MIT</license>

  <exec_depend>actr_lab1</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
